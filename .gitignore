# Only source/configuration templates may enter Git. Never track runtime/user state.
*
!/.gitignore
!/SECURITY-REVIEW.md
!/README.md
!/PLUGIN-HANDOFF.md
!/install.ps1
!/Start-Harness.ps1
!/verify-release.ps1
!/runtime/
!/runtime/package.json
!/runtime/pnpm-workspace.yaml
!/runtime/pnpm-lock.yaml
!/runtime/patches/
!/runtime/patches/*.patch
!/profiles/
!/profiles/web/
!/profiles/web/package.json
!/profiles/web/cordis.yml
!/profiles/web/cordis.patch.yml.in
!/profiles/web/pnpm-workspace.yaml
!/profiles/web/pnpm-lock.yaml
!/profiles/web/patches/
!/profiles/web/patches/*.patch
!/profiles/web/presets/
!/profiles/web/presets/light/
!/profiles/web/presets/light/bootstrap.mjs
!/plugins/
!/plugins/dsh-codex-failover/
!/plugins/dsh-codex-failover/package.json
!/plugins/dsh-codex-failover/index.js
!/plugins/dsh-locale-uk/
!/plugins/dsh-locale-uk/package.json
!/plugins/dsh-locale-uk/index.js
!/plugins/dsh-locale-uk/client.js
!/plugins/dsh-wide-chat/
!/plugins/dsh-wide-chat/package.json
!/plugins/dsh-wide-chat/index.js
!/plugins/dsh-wide-chat/client.js
!/plugins/dsh-headroom/
!/plugins/dsh-headroom/package.json
!/plugins/dsh-headroom/cordis.patch.yml
!/plugins/dsh-headroom/dsh.plugin.json
!/plugins/dsh-headroom/LICENSE
!/plugins/dsh-headroom/NOTICE
!/plugins/dsh-headroom/lib/
!/plugins/dsh-headroom/lib/*.js
