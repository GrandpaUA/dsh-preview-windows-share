# Restore the source's default preset and title policy after migration.
- id: agent-preset-registry
  config:
    default: light
- id: session-title-llm
  disabled: true
- insert:
    - id: locale-uk
      name: '@local/dsh-locale-uk'
    - id: dsh-themes
      name: '@dshthemes/ui'
- id: dsh-headroom
  config:
    ccr:
      persist: false
- id: llm-deepseek
  disabled: true
- id: ui-settings-general
  name: '@deepseek-ai/dsh-client-ui-settings-general'
  config:
    welcomeNoticeVersion: 2026-09-28.1
- id: ui-theme
  name: '@deepseek-ai/dsh-client-ui-theme'
  config:
    preference: dark
- id: permission
  name: '@deepseek-ai/dsh-permission-presets'
  config:
    presets:
      read-only:
        sandbox: read-only
        approval: ask
      workspace-write:
        sandbox: workspace-write
        approval: ask
      danger-full-access:
        sandbox: danger-full-access
        approval: never
    defaultPreset: workspace-write
- id: agent-default-model
  name: '@deepseek-ai/dsh-agent-default-model'
  config:
    provider: openai-codex
    model: gpt-6-sol
    reasoningEffort: high
- id: locale
  name: '@deepseek-ai/dsh-client-locale'
  config:
    preference: uk
- id: llm-pi-ai
  config:
    providers:
      openai-codex:
        apiKeyEnv: CODEX_CHATGPT_TOKEN
        models:
          - id: gpt-6-astra
            name: GPT-6 Astra
            contextWindow: 272000
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max
